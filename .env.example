# ==============================================================================
# Eedi-RAG 大模型抽取与检索环境配置文件示例 (.env.example)
# 复制本文件并重命名为 .env，填入你的 API Key 即可一键启用真实大模型在线知识抽取
# ==============================================================================

# 【方案一：DeepSeek 官方 API (高性价比首选，强烈推荐)】
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 【方案二：OpenAI 官方 API】
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 【方案三：硅基流动 SiliconFlow (支持 Qwen-2.5 / DeepSeek 等超多开源模型)】
# LLM_API_KEY=sk-your-siliconflow-api-key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 【方案四：本地私有化部署 Ollama / vLLM (0 API 费用)】
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# 通用参数
LLM_TEMPERATURE=0.1
# 交互流式默认关闭 MiMo 深度思考以降低首字延迟；需要复杂推理时改为 enabled
LLM_STREAM_THINKING=disabled
# 交互流式默认使用提示词 JSON（保留本地严格校验）；需要服务端 JSON 模式时改为 json_object
LLM_STREAM_JSON_MODE=prompt

# Embedding（项目初期使用 SiliconFlow OpenAI-compatible API）
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_API_KEY_ENV=SILICONFLOW_API_KEY
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=32

# 评测 Judge 使用同一 API 契约，但模型必须显式配置，不能以默认模型伪装成功。
# 若 Judge 与生成模型相同，可填写相同模型名。
# JUDGE_LLM_MODEL=deepseek-chat
